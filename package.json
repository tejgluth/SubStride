{
  "name": "substride",
  "version": "0.1.0",
  "private": true,
  "description": "SubStride V1 monorepo: firmware, mobile app foundation, deterministic analytics, simulator data, and validation tooling.",
  "workspaces": [
    "analytics",
    "mobile-app"
  ],
  "scripts": {
    "build": "npm -w @substride/analytics run build",
    "test": "vitest run",
    "generate:sample-data": "tsx scripts/generate-sample-data.ts",
    "validate:sample-data": "tsx scripts/validate-sample-data.ts"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "ajv": "8.18.0",
    "fast-xml-parser": "5.7.0",
    "postcss": "8.5.10",
    "send": "0.19.0",
    "tar": "7.5.15",
    "uuid": "11.1.1",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@react-native-community/cli-platform-android": {
      "fast-xml-parser": "5.7.0"
    },
    "@react-native-community/cli-platform-apple": {
      "fast-xml-parser": "5.7.0"
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.85.3",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
